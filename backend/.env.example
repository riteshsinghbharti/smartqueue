# SQLite Database (In-container or mounted Render volume)
DATABASE_URL=sqlite+aiosqlite:///./clinic_queue.db

# If using a Render persistent disk mounted at /data:
# DATABASE_URL=sqlite+aiosqlite:////data/clinic_queue.db

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000,*

# Frontend Base URL (encoded into QR code)
FRONTEND_BASE_URL=http://localhost:5173

# Server Settings
PORT=8000
CACHE_TTL_SECONDS=30
